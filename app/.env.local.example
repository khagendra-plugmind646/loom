# Copy to app/.env.local (or app/.env) and fill in. Values below are the public devnet deployment.
# Cluster: devnet | mainnet-beta | localnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional: a dedicated RPC (recommended — public RPCs rate-limit getProgramAccounts)
# NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=...
# Program id (defaults to the id in the IDL)
NEXT_PUBLIC_PROGRAM_ID=wrCPKEKsMDgLdpNFJwGK8LSvWVRUnuEsbQVAZAXkoBQ
# Stablecoin mints. Mainnet defaults to Circle USDC / Tether USDT; for your own devnet deploy run `pnpm bootstrap`.
NEXT_PUBLIC_USDC_MINT=9tCLWV44kM9ip16ivPJ9G869AqPSume1VsTBrXUJjZzC
NEXT_PUBLIC_USDT_MINT=71HjenAsdcJDDdXg7Qy2mz1UBQ6gNSEEATj6VdC97zX4

# ---- Server-only (no NEXT_PUBLIC_ prefix: never sent to browsers) ----
# Admin wallet (PUBLIC ADDRESS ONLY) allowed to open the help inbox and the database on /admin.
# LOOM_ADMIN_WALLET=
# Devnet faucet wallet for /api/faucet: the JSON array from .keys/faucet.json. Test tokens only; never the deploy key.
# FAUCET_SECRET_KEY=
# Admin database (Neon / Supabase Postgres). Filled by `pnpm indexer --cluster devnet`,
# read only through the admin-signed /api/admin/db route.
# Supabase: use the pooler URI from Connect (IPv4) and URL-encode symbols in the password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify
